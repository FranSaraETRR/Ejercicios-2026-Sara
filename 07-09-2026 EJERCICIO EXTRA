#include <stdio.h>

// Funcion para ordenar de mayor a menor
void ordenar(int vector[]) {
    int x, y, aux;

    for (x = 0; x < 10; x++) {
        for (y = x + 1; y < 10; y++) {

            if (vector[x] < vector[y]) {
                aux = vector[x];
                vector[x] = vector[y];
                vector[y] = aux;
            }
        }
    }
}

// Funcion para sumar y calcular el promedio
void promedio(int vector[]) {
    int x;
    int suma = 0;
    float prom;

    for (x = 0; x < 10; x++) {
        suma = suma + vector[x];
    }

    prom = (float)suma / 10;

    printf("\nLa suma de los valores es: %d\n", suma);
    printf("El promedio es: %.2f\n", prom);
}

int main() {
    int vector[10];
    int x;

    // Ingresar los datos
    for (x = 0; x < 10; x++) {
        printf("Ingrese el dato %d: ", x + 1);
        scanf("%d", &vector[x]);
    }

    // Ordenar el vector
    ordenar(vector);

    // Mostrar el vector ordenado
    printf("\nVector ordenado de mayor a menor:\n");

    for (x = 0; x < 10; x++) {
        printf("%d\n", vector[x]);
    }

    // Calcular suma y promedio
    promedio(vector);

    return 0;
}
